# App
APP_NAME=RavenTech OSINT
APP_VERSION=5.0.0-rc6
APP_MODE=local
DESKTOP_MODE_ENABLED=false
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_BACKEND_URL=http://localhost:8000
LOCAL_OPERATOR_OPEN_BROWSER=true
APP_RELEASE_CHANNEL=release-candidate
RELEASE_CHANNEL=release-candidate
APP_BUILD_DATE=local
APP_GIT_COMMIT=
SECRET_KEY=change-me-to-a-64-byte-random-hex-string
APP_SECRET_KEY=change-me-to-a-64-byte-random-hex-string
APP_ENVIRONMENT=development
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://tauri.localhost,tauri://localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://tauri.localhost,tauri://localhost
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://tauri.localhost,tauri://localhost
FRONTEND_URL=http://localhost:5173
MAX_REQUEST_BODY_BYTES=2000000
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=900
LOG_LEVEL=DEBUG
REQUEST_ID_HEADER=X-Request-ID
ENABLE_DEMO_MODE=false
DESKTOP_AUTO_MONITORING_ENABLED=true
MONITORING_AUTO_REFRESH_ENABLED=true
MONITORING_AUTO_REFRESH_SECONDS=30
LAN_MONITORING_ENABLED=false
LAN_ALLOWED_CIDRS=192.168.50.0/24
LAN_GATEWAY_HINT=192.168.50.1
LAN_DISCOVERY_INTERVAL_SECONDS=300
LAN_DISCOVERY_PING_ENABLED=false
LAN_AUTO_DISCOVERY_ON_START=false
LAN_AUTO_SERVICE_CHECK_ON_START=false
LAN_AUTO_DISCOVERY_INTERVAL_SECONDS=300
LAN_AUTO_SERVICE_CHECK_INTERVAL_SECONDS=600
LAN_SERVICE_CHECK_ENABLED=false
LAN_SERVICE_CHECK_PORTS=22,80,443,445,3389,8080,8443,3000,5000,5432,6379,8000,9000
LAN_SERVICE_CHECK_TIMEOUT_SECONDS=2
LAN_SERVICE_CHECK_MAX_HOSTS=256
LAN_SERVICE_CHECK_MAX_PORTS=32
LAN_REJECT_PUBLIC_CIDRS=true
LAN_SSH_BANNER_DETECTION_ENABLED=true
LAN_AGENT_TOKEN=
LAN_AGENT_MAX_STALE_MINUTES=10
VULNERABILITY_BASELINE_ENABLED=true
VULNERABILITY_HIGH_RESOURCE_PERCENT=90
VULNERABILITY_RESOURCE_SUSTAINED_SAMPLES=3
VULNERABILITY_STALE_ASSET_HOURS=24
PUBLIC_REGISTRATION_ENABLED=false
REGISTRATION_REQUIRES_APPROVAL=true
REGISTRATION_INVITE_CODE=
DEFAULT_REGISTERED_USER_ROLE=viewer

# Database
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://raventech:replace-with-a-strong-postgres-password@postgres:5432/raventech
TEST_DATABASE_URL=postgresql+asyncpg://raventech:replace-with-a-strong-postgres-password@localhost:5432/raventech_test
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_SECONDS=1
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
REDIS_CONNECT_RETRIES=5
REDIS_CONNECT_RETRY_SECONDS=1
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_WORKER_CONCURRENCY=2

# ChromaDB local persistence path for the knowledge index.
CHROMA_DATA_PATH=/data/chroma

# AI analysis provider. Leave API key empty to return provider_unavailable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=

# Local Obsidian/Markdown knowledge source path.
OBSIDIAN_WIKI_PATH=

# Report branding. Logo is optional and may be left blank.
REPORT_COMPANY_NAME=RavenTech
REPORT_LOGO_PATH=
REPORT_PRIMARY_COLOR=#7C3AED
REPORT_SECONDARY_COLOR=#111827

# OSINT API placeholders for later phases. Leave empty in Phase 0.
SHODAN_API_KEY=
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
SECURITYTRAILS_API_KEY=
CENSYS_API_ID=
CENSYS_SECRET=
HIBP_API_KEY=
GITHUB_TOKEN=

# Admin Bootstrap
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@raventech.mx
ADMIN_PASSWORD=replace-with-a-strong-admin-password
